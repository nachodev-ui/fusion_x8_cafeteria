# URL definitiva del sitio. Permite generar canonical y Open Graph absolutos.
# Copia este archivo a .env y completa el dominio antes del build de producción.
# PUBLIC_SITE_URL=https://tu-dominio.cl

# Opcional: calificación y reseñas actualizadas en las tarjetas del sitio.
# Requiere un proyecto con facturación, Maps JavaScript API y Places API (New) activos.
# Clave de navegador pública, restringida al dominio y a las APIs necesarias.
# PUBLIC_GOOGLE_MAPS_API_KEY=

# Administración: copiar los valores PÚBLICOS del bloque backend PKCE generado
# por DecapBridge. Dejar todos vacíos mantiene el panel sin conexión.
# No son secretos: se incluyen en el HTML del panel. NUNCA poner aquí un PAT,
# contraseña, client_secret ni token de escritura.
CMS_BRIDGE_BASE_URL=
CMS_BRIDGE_GATEWAY_URL=
CMS_BRIDGE_AUTH_ENDPOINT=
CMS_BRIDGE_TOKEN_ENDPOINT=
# Opcionales: solo si aparecen en la configuración generada por el proveedor.
CMS_BRIDGE_CLIENT_ID=
CMS_BRIDGE_STATUS_ENDPOINT=
