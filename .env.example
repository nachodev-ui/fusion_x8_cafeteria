# URL definitiva del sitio. Permite generar canonical y Open Graph absolutos.
# Copia este archivo a .env y completa el dominio antes del build de producción.
# PUBLIC_SITE_URL=https://tu-dominio.cl

# Opcional: calificación y reseñas actualizadas en las tarjetas del sitio.
# Requiere un proyecto con facturación, Maps JavaScript API y Places API (New) activos.
# Clave de navegador pública, restringida al dominio y a las APIs necesarias.
# PUBLIC_GOOGLE_MAPS_API_KEY=

# Administración: variables de RUNTIME de Pages Functions.
# Configurar en Cloudflare Settings > Variables and Secrets.
# Para desarrollo con Wrangler, copiar los nombres a .dev.vars (ignorado).
# No usar PUBLIC_* para ningún valor de administración.
ADMIN_ORIGIN=
ADMIN_EMAIL=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
GITHUB_REPOSITORY=nachodev-ui/fusion_x8_cafeteria
GITHUB_BRANCH=main
# Secreto: configurarlo directamente en Cloudflare. Nunca incluir un valor real aquí.
GITHUB_TOKEN=
