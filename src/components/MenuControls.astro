---
import Icon from './Icon.astro';
import '../styles/menu-browser.css';
import type { categories as categoryConfig, menuGroups } from '../data/menu-config';
interface Props {
  categories: typeof categoryConfig;
  groups: typeof menuGroups;
  mode?: 'page' | 'embedded';
}
const { categories, groups, mode = 'page' } = Astro.props;
---
<div class:list={['menu-controls', mode === 'page' ? 'carta-nav' : 'menu-toolbar']} data-menu-controls data-carta-start={mode === 'embedded' ? true : undefined}>
  <nav class="menu-category-nav" aria-label="Categorías de la carta">
    {categories.map(category => <a href={mode === 'page' ? `#${category.id}` : `#panel-${category.id}`} data-menu-category={category.id}><Icon name={category.icon} size={20} /><span>{category.label}</span></a>)}
  </nav>
  <div class="menu-search" hidden data-menu-search-control>
    <Icon name="search" size={20} />
    <label class="menu-sr-only" for={`menu-search-${mode}`}>Buscar en la carta</label>
    <input id={`menu-search-${mode}`} type="search" placeholder="Busca tu próximo antojo…" autocomplete="off" spellcheck="false" data-menu-search />
    <button type="button" aria-label="Borrar búsqueda" data-menu-clear hidden><Icon name="close" size={18} /></button>
  </div>
  {categories.map(category => <div class="menu-group-nav" data-group-category={category.id} role="group" aria-label={`Tipos de ${category.label}`} hidden>
    {groups.filter(group => group.category === category.id).map(group => <button type="button" data-menu-group={group.id} aria-pressed="false">{group.id.startsWith('extras-') ? 'Extras' : group.label}</button>)}
    <button type="button" data-menu-group="all" aria-pressed="false">Ver todo</button>
  </div>)}
</div>
<p class="menu-results-status menu-sr-only" data-menu-status role="status" aria-live="polite" aria-atomic="true"></p>
