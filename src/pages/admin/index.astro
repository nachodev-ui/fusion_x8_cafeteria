---
import '../../admin/admin.css';
const bridge = {
  baseUrl: process.env.CMS_BRIDGE_BASE_URL || '',
  clientId: process.env.CMS_BRIDGE_CLIENT_ID || '',
  gatewayUrl: process.env.CMS_BRIDGE_GATEWAY_URL || '',
  authEndpoint: process.env.CMS_BRIDGE_AUTH_ENDPOINT || '',
  tokenEndpoint: process.env.CMS_BRIDGE_TOKEN_ENDPOINT || '',
  statusEndpoint: process.env.CMS_BRIDGE_STATUS_ENDPOINT || '',
};
const configured = [bridge.baseUrl, bridge.gatewayUrl, bridge.authEndpoint, bridge.tokenEndpoint].every(Boolean);
if (configured) {
  for (const url of [bridge.baseUrl, bridge.gatewayUrl, bridge.statusEndpoint].filter(Boolean)) {
    if (new URL(url).protocol !== 'https:') throw new Error('Los endpoints del gestor deben usar HTTPS.');
  }
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <title>Administrar carta · Fusión x8</title>
  </head>
  <body>
    <div id="admin-boot" role="status">
      {configured ? 'Cargando el gestor seguro…' : 'El gestor está preparado, pero falta conectar DecapBridge. El responsable técnico debe completar CMS_BRIDGE_* según README.md. No se ha habilitado ningún acceso local o de prueba.'}
    </div>
    <noscript>Activa JavaScript para iniciar sesión y administrar la carta.</noscript>
    {configured && <>
      <script is:inline>window.CMS_MANUAL_INIT = true;</script>
      <script id="bridge-config" type="application/json" set:html={JSON.stringify(bridge).replace(/</g, '\\u003c')} />
      <script is:inline src="https://cdn.jsdelivr.net/npm/decap-cms@3.17.3/dist/decap-cms.js" integrity="sha384-RWRzuHfiZSWCt3nEvG7B0v3cMgM1C2UuJmgBSL92GQh4uXmNSkbcthql/mNBqvjr" crossorigin="anonymous" onerror="document.getElementById('admin-boot').textContent='No se pudo cargar el gestor. Comprueba la conexión y vuelve a abrir esta página.'"></script>
    </>}
    <script>
      import { startAdmin } from '../../admin/bootstrap';
      const config = document.querySelector('#bridge-config');
      if (config?.textContent) {
        try { startAdmin(JSON.parse(config.textContent)); }
        catch (error) {
          const notice = document.querySelector('#admin-boot');
          if (notice) notice.textContent = 'No se pudo iniciar el gestor. Vuelve a abrir esta página y pide al responsable técnico revisar la configuración si el error continúa.';
          console.error(error);
        }
      }
    </script>
  </body>
</html>
